rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function permission(name) { return hasProfile() && profile().get('permissions', {}).get(name, false) == true; }

    function roleIsManager() {
      return hasProfile() && profile().get('role', '') in ['Manager','manager','Admin','admin','Administrator','administrator','Owner','owner'];
    }
    function isManagement() { return roleIsManager() || permission('employeesView') || permission('employeesManage'); }
    function isAdmin() {
      return hasProfile() && (
        profile().get('role', '') in ['Admin','admin','Administrator','administrator','Owner','owner'] || permission('systemAdmin')
      );
    }
    function crossDepartment() { return isAdmin() || permission('employeesCrossDepartment'); }
    function sameDepartment(data) { return hasProfile() && data.get('departmentId','') == profile().get('departmentId',''); }
    function managementCanAccess(data) { return isManagement() && (crossDepartment() || sameDepartment(data)); }
    function ownsEmployeeId(employeeId) { return hasProfile() && profile().get('employeeId','') == employeeId; }

    function employeePath(employeeId) { return /databases/$(database)/documents/employees/$(employeeId); }
    function employeeData(employeeId) { return get(employeePath(employeeId)).data; }
    function employeeIsActivationEnabled(data) {
      return data.get('status', data.get('employmentStatus','active')) == 'active' && data.get('portalAccess', true) != false && (
        data.get('portalAccess', false) == true || data.get('canSignup', false) == true || data.get('loginEnabled', false) == true || data.get('accountCreated', false) == true
      );
    }
    function verifiedEmailOwnsEmployee(data) {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email == data.get('email','') && employeeIsActivationEnabled(data);
    }
    function safeManagerPermissions(data) {
      return data.get('permissions', {}).get('systemAdmin', false) == false && data.get('permissions', {}).get('employeesCrossDepartment', false) == false;
    }
    function nonPrivilegedRole(data) {
      return !(data.get('role','Employee') in ['Admin','admin','Administrator','administrator','Owner','owner']);
    }

    function canIssueDiscipline() { return hasProfile() && (permission('disciplineIssue') || permission('canIssueWriteups') || roleIsManager()); }
    function canReviewDisciplineAppeals() { return hasProfile() && (permission('disciplineAppealsReview') || permission('canReviewAppeals') || roleIsManager()); }
    function canReviewTimeOff() { return hasProfile() && (permission('timeOffReview') || roleIsManager()); }
    function canProcessResignations() { return hasProfile() && (permission('resignationsView') || permission('resignationsProcess') || roleIsManager()); }

    match /users/{userId} {
      allow get: if (signedIn() && request.auth.uid == userId) || isAdmin() || (isManagement() && sameDepartment(resource.data));
      allow list: if isAdmin();

      allow create: if signedIn() && request.auth.uid == userId && request.auth.token.email_verified == true &&
        request.resource.data.get('uid','') == request.auth.uid &&
        exists(employeePath(request.resource.data.get('employeeId',''))) &&
        request.auth.token.email == employeeData(request.resource.data.employeeId).get('email','') &&
        employeeIsActivationEnabled(employeeData(request.resource.data.employeeId)) &&
        request.resource.data.get('email','') == employeeData(request.resource.data.employeeId).get('email','') &&
        request.resource.data.get('username','') == employeeData(request.resource.data.employeeId).get('username', employeeData(request.resource.data.employeeId).get('displayName','Employee')) &&
        request.resource.data.get('position','') == employeeData(request.resource.data.employeeId).get('position','') &&
        request.resource.data.get('departmentId','') == employeeData(request.resource.data.employeeId).get('departmentId','') &&
        request.resource.data.get('departmentName','') == employeeData(request.resource.data.employeeId).get('departmentName','') &&
        request.resource.data.get('role','Employee') == employeeData(request.resource.data.employeeId).get('role','Employee') &&
        request.resource.data.get('status','') == 'active' &&
        (
          (employeeData(request.resource.data.employeeId).keys().hasAny(['permissions']) && request.resource.data.get('permissions',{}) == employeeData(request.resource.data.employeeId).get('permissions',{})) ||
          (!employeeData(request.resource.data.employeeId).keys().hasAny(['permissions']) && request.resource.data.get('permissions',{}) == {})
        );

      allow update: if isAdmin() || (
        isManagement() && sameDepartment(resource.data) &&
        request.resource.data.get('employeeId','') == resource.data.get('employeeId','') &&
        request.resource.data.get('departmentId','') == resource.data.get('departmentId','') &&
        nonPrivilegedRole(request.resource.data) && safeManagerPermissions(request.resource.data)
      );
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow get: if managementCanAccess(resource.data) || ownsEmployeeId(employeeId) || verifiedEmailOwnsEmployee(resource.data);
      allow list: if crossDepartment();

      allow create: if isAdmin() || (
        isManagement() && !crossDepartment() && request.resource.data.get('departmentId','') == profile().get('departmentId','') &&
        nonPrivilegedRole(request.resource.data) && safeManagerPermissions(request.resource.data)
      );

      allow update: if isAdmin() || (
        isManagement() && !crossDepartment() && resource.data.get('departmentId','') == profile().get('departmentId','') &&
        request.resource.data.get('departmentId','') == resource.data.get('departmentId','') &&
        nonPrivilegedRole(request.resource.data) && safeManagerPermissions(request.resource.data)
      ) || (
        verifiedEmailOwnsEmployee(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountCreated','linkedUid','loginEnabled','lastUpdated']) &&
        request.resource.data.get('accountCreated',false) == true && request.resource.data.get('linkedUid','') == request.auth.uid && request.resource.data.get('loginEnabled',false) == true
      );
      allow delete: if isAdmin();
    }

    match /writeUps/{writeUpId} {
      allow read: if ownsEmployeeId(resource.data.get('employeeId','')) || managementCanAccess(resource.data);
      allow create: if canIssueDiscipline() && (crossDepartment() || request.resource.data.get('departmentId','') == profile().get('departmentId','')) &&
        request.resource.data.get('issuedByEmployeeId','') == profile().get('employeeId','') && request.resource.data.get('status','') == 'active';
      allow update: if managementCanAccess(resource.data) || (
        ownsEmployeeId(resource.data.get('employeeId','')) && resource.data.get('status','active') == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['underAppeal','updatedAt']) && request.resource.data.get('underAppeal',false) == true
      );
      allow delete: if isAdmin();
    }

    match /appeals/{appealId} {
      allow read: if ownsEmployeeId(resource.data.get('employeeId','')) || (canReviewDisciplineAppeals() && (crossDepartment() || sameDepartment(resource.data)));
      allow create: if hasProfile() && request.resource.data.get('employeeId','') == profile().get('employeeId','') &&
        request.resource.data.get('departmentId','') == profile().get('departmentId','') && request.resource.data.get('status','') == 'pending' && request.resource.data.get('reviewedBy',null) == null;
      allow update: if canReviewDisciplineAppeals() && (crossDepartment() || sameDepartment(resource.data));
      allow delete: if isAdmin();
    }

    match /timeOffRequests/{requestId} {
      allow read: if ownsEmployeeId(resource.data.get('employeeId','')) || (canReviewTimeOff() && (crossDepartment() || sameDepartment(resource.data)));
      allow create: if hasProfile() && request.resource.data.get('employeeId','') == profile().get('employeeId','') && request.resource.data.get('departmentId','') == profile().get('departmentId','') && request.resource.data.get('status','') == 'pending';
      allow update: if (canReviewTimeOff() && (crossDepartment() || sameDepartment(resource.data))) || (
        ownsEmployeeId(resource.data.get('employeeId','')) && resource.data.get('status','') == 'pending' && request.resource.data.get('status','') == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /resignationNotices/{noticeId} {
      allow read: if ownsEmployeeId(resource.data.get('employeeId','')) || (canProcessResignations() && (crossDepartment() || sameDepartment(resource.data)));
      allow create: if hasProfile() && request.resource.data.get('employeeId','') == profile().get('employeeId','') && request.resource.data.get('departmentId','') == profile().get('departmentId','') && request.resource.data.get('status','') == 'submitted';
      allow update: if (canProcessResignations() && (crossDepartment() || sameDepartment(resource.data))) || (
        ownsEmployeeId(resource.data.get('employeeId','')) && resource.data.get('status','') == 'submitted' && request.resource.data.get('status','') == 'withdrawn' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','withdrawnAt','updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /signupRequests/{requestId} {
      allow read, write: if isAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
