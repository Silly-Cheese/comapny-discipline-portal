rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth!=null;}
    function userPath(){return /databases/$(database)/documents/users/$(request.auth.uid);}
    function hasProfile(){return signedIn()&&exists(userPath());}
    function profile(){return get(userPath()).data;}
    function activeProfile(){return hasProfile()&&profile().get('status','active')=='active';}
    function permission(name){return activeProfile()&&profile().get('permissions',{}).get(name,false)==true;}
    function roleIsManager(){return activeProfile()&&profile().get('role','') in ['Manager','manager','Admin','admin','Administrator','administrator','Owner','owner'];}
    function isManagement(){return roleIsManager()||permission('employeesView')||permission('employeesManage');}
    function canManageEmployees(){return activeProfile()&&(permission('employeesManage')||profile().get('role','') in ['Manager','manager','Admin','admin','Administrator','administrator','Owner','owner']);}
    function isAdmin(){return activeProfile()&&(profile().get('role','') in ['Admin','admin','Administrator','administrator','Owner','owner']||permission('systemAdmin'));}
    function crossDepartment(){return isAdmin()||permission('employeesCrossDepartment');}
    function sameDepartment(data){return activeProfile()&&data.get('departmentId','')==profile().get('departmentId','');}
    function managementCanAccess(data){return isManagement()&&(crossDepartment()||sameDepartment(data));}
    function ownsEmployeeId(employeeId){return activeProfile()&&profile().get('employeeId','')==employeeId;}
    function employeePath(employeeId){return /databases/$(database)/documents/employees/$(employeeId);}
    function employeeData(employeeId){return get(employeePath(employeeId)).data;}
    function employeeIsActivationEnabled(data){return data.get('status',data.get('employmentStatus','active'))=='active'&&data.get('portalAccess',true)!=false&&(data.get('portalAccess',false)==true||data.get('canSignup',false)==true||data.get('loginEnabled',false)==true||data.get('accountCreated',false)==true);}
    function verifiedEmailOwnsEmployee(data){return signedIn()&&request.auth.token.email_verified==true&&request.auth.token.email==data.get('email','')&&employeeIsActivationEnabled(data);}
    function nonPrivilegedRole(data){return !(data.get('role','Employee') in ['Admin','admin','Administrator','administrator','Owner','owner']);}
    function safeManagerPermissions(data){return data.get('permissions',{}).get('systemAdmin',false)==false&&data.get('permissions',{}).get('employeesCrossDepartment',false)==false;}
    function canIssueDiscipline(){return activeProfile()&&(permission('disciplineIssue')||permission('canIssueWriteups')||roleIsManager());}
    function canReviewDisciplineAppeals(){return activeProfile()&&(permission('disciplineAppealsReview')||permission('canReviewAppeals')||roleIsManager());}
    function writeUpPath(id){return /databases/$(database)/documents/writeUps/$(id);}
    function canReviewTimeOff(){return activeProfile()&&(permission('timeOffReview')||roleIsManager());}
    function canViewResignations(){return activeProfile()&&(permission('resignationsView')||permission('resignationsProcess')||roleIsManager());}
    function canProcessResignations(){return activeProfile()&&(permission('resignationsProcess')||isAdmin());}
    function resignationPath(id){return /databases/$(database)/documents/resignationNotices/$(id);}
    function activeResignationPath(employeeId){return /databases/$(database)/documents/resignationActive/$(employeeId);}
    function auditIdentity(data){return activeProfile()&&data.get('actorUid','')==request.auth.uid&&data.get('actorEmployeeId','')==profile().get('employeeId','')&&data.get('actorRole','')==profile().get('role','')&&data.get('actorDepartmentId','')==profile().get('departmentId','')&&data.get('createdAt',null)==request.time;}
    function auditTargetAllowed(data){return crossDepartment()||data.get('targetDepartmentId','')==profile().get('departmentId','');}
    function auditAllowed(data){
      return auditIdentity(data)&&(
        (data.get('action','') in ['account.activated','discipline.acknowledged','discipline.appeal_submitted','time_off.submitted','time_off.cancelled','resignation.submitted','resignation.withdrawn']&&data.get('targetEmployeeId','')==profile().get('employeeId',''))||
        (data.get('action','') in ['discipline.issued','discipline.case_updated']&&canIssueDiscipline()&&auditTargetAllowed(data))||
        (data.get('action','')=='discipline.appeal_reviewed'&&canReviewDisciplineAppeals()&&auditTargetAllowed(data))||
        (data.get('action','') in ['time_off.approved','time_off.denied']&&canReviewTimeOff()&&auditTargetAllowed(data))||
        (data.get('action','')=='resignation.acknowledged'&&canViewResignations()&&auditTargetAllowed(data))||
        (data.get('action','')=='resignation.processed'&&canProcessResignations()&&auditTargetAllowed(data))||
        (data.get('action','') in ['employee.created','employee.updated','employee.portal_disabled']&&canManageEmployees()&&auditTargetAllowed(data))||
        (data.get('action','')=='settings.updated'&&isAdmin())
      );
    }

    match /users/{userId} {
      allow get: if (signedIn()&&request.auth.uid==userId)||isAdmin()||(isManagement()&&sameDepartment(resource.data));
      allow list: if isAdmin();
      allow create: if signedIn()&&request.auth.uid==userId&&request.auth.token.email_verified==true&&request.resource.data.get('uid','')==request.auth.uid&&exists(employeePath(request.resource.data.get('employeeId','')))&&request.auth.token.email==employeeData(request.resource.data.employeeId).get('email','')&&employeeIsActivationEnabled(employeeData(request.resource.data.employeeId))&&request.resource.data.get('email','')==employeeData(request.resource.data.employeeId).get('email','')&&request.resource.data.get('username','')==employeeData(request.resource.data.employeeId).get('username',employeeData(request.resource.data.employeeId).get('displayName','Employee'))&&request.resource.data.get('position','')==employeeData(request.resource.data.employeeId).get('position','')&&request.resource.data.get('departmentId','')==employeeData(request.resource.data.employeeId).get('departmentId','')&&request.resource.data.get('departmentName','')==employeeData(request.resource.data.employeeId).get('departmentName','')&&request.resource.data.get('role','Employee')==employeeData(request.resource.data.employeeId).get('role','Employee')&&request.resource.data.get('status','')=='active'&&request.resource.data.get('permissions',{})==employeeData(request.resource.data.employeeId).get('permissions',{});
      allow update: if isAdmin()||(canManageEmployees()&&sameDepartment(resource.data)&&request.resource.data.get('employeeId','')==resource.data.get('employeeId','')&&request.resource.data.get('departmentId','')==resource.data.get('departmentId','')&&request.resource.data.get('role','')==resource.data.get('role','')&&request.resource.data.get('email','')==resource.data.get('email','')&&request.resource.data.get('permissions',{})==resource.data.get('permissions',{})&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','position','status','lastUpdated']))||(canProcessResignations()&&(crossDepartment()||sameDepartment(resource.data))&&request.resource.data.get('status','')=='inactive'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','lastUpdated']));
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow get: if managementCanAccess(resource.data)||ownsEmployeeId(employeeId)||verifiedEmailOwnsEmployee(resource.data);
      allow list: if crossDepartment();
      allow create: if isAdmin()||(canManageEmployees()&&!crossDepartment()&&request.resource.data.get('departmentId','')==profile().get('departmentId','')&&nonPrivilegedRole(request.resource.data)&&safeManagerPermissions(request.resource.data));
      allow update: if isAdmin()||(canManageEmployees()&&!crossDepartment()&&resource.data.get('departmentId','')==profile().get('departmentId','')&&request.resource.data.get('departmentId','')==resource.data.get('departmentId','')&&request.resource.data.get('role','')==resource.data.get('role','')&&request.resource.data.get('permissions',{})==resource.data.get('permissions',{})&&(request.resource.data.get('email','')==resource.data.get('email','')||resource.data.get('accountCreated',false)==false)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','displayName','email','position','managerEmail','status','employmentStatus','portalAccess','loginEnabled','lastUpdated']))||(verifiedEmailOwnsEmployee(resource.data)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountCreated','linkedUid','loginEnabled','lastUpdated'])&&request.resource.data.get('accountCreated',false)==true&&request.resource.data.get('linkedUid','')==request.auth.uid&&request.resource.data.get('loginEnabled',false)==true)||(canProcessResignations()&&(crossDepartment()||sameDepartment(resource.data))&&request.resource.data.get('status','')=='resigned'&&request.resource.data.get('employmentStatus','')=='resigned'&&request.resource.data.get('portalAccess',true)==false&&request.resource.data.get('loginEnabled',true)==false&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','employmentStatus','portalAccess','loginEnabled','lastUpdated']));
      allow delete: if isAdmin();
    }

    match /writeUps/{writeUpId} {
      allow read: if ownsEmployeeId(resource.data.get('employeeId',''))||managementCanAccess(resource.data);
      allow create: if canIssueDiscipline()&&exists(employeePath(request.resource.data.get('employeeId','')))&&(crossDepartment()||request.resource.data.get('departmentId','')==profile().get('departmentId',''))&&request.resource.data.get('departmentId','')==employeeData(request.resource.data.employeeId).get('departmentId','')&&request.resource.data.get('issuedByUid','')==request.auth.uid&&request.resource.data.get('issuedByEmployeeId','')==profile().get('employeeId','')&&request.resource.data.get('caseId','')!=''&&request.resource.data.get('status','')=='active'&&request.resource.data.get('acknowledged',false)==false&&request.resource.data.get('underAppeal',false)==false;
      allow update: if (managementCanAccess(resource.data)&&request.resource.data.get('employeeId','')==resource.data.get('employeeId','')&&request.resource.data.get('departmentId','')==resource.data.get('departmentId','')&&request.resource.data.get('issuedByEmployeeId','')==resource.data.get('issuedByEmployeeId','')&&request.resource.data.get('caseId','')==resource.data.get('caseId','')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category','actionType','severity','policy','reason','expectations','evidenceLinks','status','acknowledgmentRequired','underAppeal','lastAppealDecision','lastAppealReviewedAt','updatedAt']))||(ownsEmployeeId(resource.data.get('employeeId',''))&&resource.data.get('status','active')=='active'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['underAppeal','acknowledged','acknowledgedAt','acknowledgedByUid','updatedAt'])&&(request.resource.data.get('underAppeal',false)==resource.data.get('underAppeal',false)||request.resource.data.get('underAppeal',false)==true)&&(request.resource.data.get('acknowledged',false)==resource.data.get('acknowledged',false)||(request.resource.data.get('acknowledged',false)==true&&request.resource.data.get('acknowledgedByUid','')==request.auth.uid)));
      allow delete: if isAdmin();
    }

    match /disciplineInternal/{writeUpId} {
      allow read: if managementCanAccess(resource.data);
      allow create: if canIssueDiscipline()&&exists(employeePath(request.resource.data.get('employeeId','')))&&request.resource.data.get('writeUpId','')==writeUpId&&request.resource.data.get('departmentId','')==employeeData(request.resource.data.employeeId).get('departmentId','')&&(crossDepartment()||request.resource.data.get('departmentId','')==profile().get('departmentId',''));
      allow update: if managementCanAccess(resource.data)&&request.resource.data.get('writeUpId','')==resource.data.get('writeUpId','')&&request.resource.data.get('employeeId','')==resource.data.get('employeeId','')&&request.resource.data.get('departmentId','')==resource.data.get('departmentId','')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerNotes','updatedByUid','updatedAt','caseId']);
      allow delete: if isAdmin();
    }

    match /appeals/{appealId} {
      allow read: if ownsEmployeeId(resource.data.get('employeeId',''))||(canReviewDisciplineAppeals()&&(crossDepartment()||sameDepartment(resource.data)));
      allow create: if activeProfile()&&request.resource.data.get('employeeId','')==profile().get('employeeId','')&&request.resource.data.get('departmentId','')==profile().get('departmentId','')&&request.resource.data.get('status','')=='pending'&&request.resource.data.get('reviewedBy',null)==null&&exists(writeUpPath(request.resource.data.get('writeUpId','')))&&get(writeUpPath(request.resource.data.writeUpId)).data.get('employeeId','')==profile().get('employeeId','')&&get(writeUpPath(request.resource.data.writeUpId)).data.get('status','active')=='active'&&get(writeUpPath(request.resource.data.writeUpId)).data.get('underAppeal',false)==false;
      allow update: if canReviewDisciplineAppeals()&&(crossDepartment()||sameDepartment(resource.data))&&resource.data.get('status','')=='pending'&&request.resource.data.get('status','')=='reviewed'&&request.resource.data.get('reviewedBy','')==request.auth.uid&&request.resource.data.get('employeeId','')==resource.data.get('employeeId','')&&request.resource.data.get('writeUpId','')==resource.data.get('writeUpId','')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decision','decisionReason','reviewedBy','reviewedByUsername','reviewedAt']);
      allow delete: if isAdmin();
    }

    match /timeOffRequests/{requestId} {
      allow read: if ownsEmployeeId(resource.data.get('employeeId',''))||(canReviewTimeOff()&&(crossDepartment()||sameDepartment(resource.data)));
      allow create: if activeProfile()&&request.resource.data.get('employeeId','')==profile().get('employeeId','')&&request.resource.data.get('departmentId','')==profile().get('departmentId','')&&request.resource.data.get('status','')=='pending'&&request.resource.data.get('reviewedBy',null)==null&&request.resource.data.get('startDate','')!=''&&request.resource.data.get('endDate','')!='';
      allow update: if (canReviewTimeOff()&&(crossDepartment()||sameDepartment(resource.data))&&resource.data.get('status','')=='pending'&&request.resource.data.get('status','') in ['approved','denied']&&request.resource.data.get('reviewedBy','')==request.auth.uid&&request.resource.data.get('employeeId','')==resource.data.get('employeeId','')&&request.resource.data.get('departmentId','')==resource.data.get('departmentId','')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionNote','reviewedBy','reviewedByUsername','reviewedAt','updatedAt']))||(ownsEmployeeId(resource.data.get('employeeId',''))&&resource.data.get('status','')=='pending'&&request.resource.data.get('status','')=='cancelled'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','updatedAt']));
      allow delete: if isAdmin();
    }

    match /resignationNotices/{noticeId} {
      allow read: if ownsEmployeeId(resource.data.get('employeeId',''))||(canViewResignations()&&(crossDepartment()||sameDepartment(resource.data)));
      allow create: if activeProfile()&&request.resource.data.get('employeeId','')==profile().get('employeeId','')&&request.resource.data.get('departmentId','')==profile().get('departmentId','')&&request.resource.data.get('status','')=='submitted'&&getAfter(activeResignationPath(profile().get('employeeId',''))).data.get('noticeId','')==noticeId&&getAfter(activeResignationPath(profile().get('employeeId',''))).data.get('employeeId','')==profile().get('employeeId','');
      allow update: if (canViewResignations()&&(crossDepartment()||sameDepartment(resource.data))&&resource.data.get('status','')=='submitted'&&request.resource.data.get('status','')=='acknowledged'&&request.resource.data.get('acknowledgedBy','')==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','managementNote','acknowledgedBy','acknowledgedByUsername','acknowledgedAt','updatedAt']))||(canProcessResignations()&&(crossDepartment()||sameDepartment(resource.data))&&resource.data.get('status','')=='acknowledged'&&request.resource.data.get('status','')=='processed'&&request.resource.data.get('processedBy','')==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','managementNote','processedBy','processedByUsername','processedAt','updatedAt']))||(ownsEmployeeId(resource.data.get('employeeId',''))&&resource.data.get('status','') in ['submitted','acknowledged']&&request.resource.data.get('status','')=='withdrawn'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','withdrawnAt','updatedAt']));
      allow delete: if isAdmin();
    }

    match /resignationActive/{employeeId} {
      allow read: if ownsEmployeeId(employeeId)||(canViewResignations()&&(crossDepartment()||sameDepartment(resource.data)));
      allow create: if activeProfile()&&employeeId==profile().get('employeeId','')&&request.resource.data.get('employeeId','')==employeeId&&request.resource.data.get('departmentId','')==profile().get('departmentId','')&&request.resource.data.get('status','')=='active'&&getAfter(resignationPath(request.resource.data.get('noticeId',''))).data.get('employeeId','')==employeeId&&getAfter(resignationPath(request.resource.data.get('noticeId',''))).data.get('status','')=='submitted';
      allow update: if false;
      allow delete: if (ownsEmployeeId(employeeId)||canProcessResignations())&&getAfter(resignationPath(resource.data.get('noticeId',''))).data.get('status','') in ['withdrawn','processed'];
    }

    match /signupRequests/{requestId}{allow read,write:if isAdmin();}
    match /systemSettings/{settingId}{allow read:if activeProfile();allow write:if isAdmin();}
    match /auditLogs/{logId}{allow read:if isAdmin();allow create:if auditAllowed(request.resource.data);allow update,delete:if false;}
    match /{document=**}{allow read,write:if false;}
  }
}
